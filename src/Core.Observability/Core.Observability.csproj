<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<UseLocalObservabilityAbstractions Condition="'$(UseLocalObservabilityAbstractions)' == ''">false</UseLocalObservabilityAbstractions>
	<!-- Multi-targeting: net9.0/net10.0 assets are built from the same source as net8.0. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>CoreSystem.Observability</PackageId>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <Authors>Federin Pastor Gutierrez Ortiz</Authors>
    <Description>Standardized observability for .NET 8 Cloud-Native apps with OpenTelemetry and Serilog.</Description>
    <PackageReleaseNotes>
      1.0.2: Package-only fix. The 1.0.1 nuspec declared CoreSystem.Observability.Abstractions 1.0.0 because the package was tagged before the central pin was refreshed. This release declares 1.0.1. No code or API changes.
      1.0.3: Dependency refresh plus a configuration-binding fix. Dependencies: OpenTelemetry stack 1.19.0 to 1.20.0 (Sdk, Api, Exporter.OpenTelemetryProtocol, Extensions.Hosting and the AspNetCore/Http/Runtime/SqlClient instrumentations); Microsoft.Data.SqlClient 7.1.0 to 7.1.1; System.Security.Cryptography.Pkcs pinned to 8.0.2 to clear a Moderate advisory; CoreSystem.Observability.Abstractions refreshed to 1.0.2 (Microsoft.Extensions.Diagnostics.HealthChecks 8.0.32). Fix: each exporter now binds only its own configuration subsection (OpenTelemetry:Tracing, OpenTelemetry:Metrics, OpenTelemetry:Logging) instead of the whole OpenTelemetry section, and an invalid value no longer aborts startup. Previously a malformed value such as a non-numeric Tracing:SamplingProbability threw InvalidOperationException from AddObservability and prevented the host from starting. Invalid values are now reported through Trace and the affected exporter falls back to its defaults; a valid Enabled flag is still honoured so one bad value cannot silently disable tracing or metrics. No public API changes.
    </PackageReleaseNotes>
    <RepositoryUrl>https://github.com/FEDERIN/CoreSystem</RepositoryUrl>
	<PackageProjectUrl>https://github.com/FEDERIN/CoreSystem/tree/main/src/Core.Observability</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
	<None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Data.SqlClient" />
	
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" />
	<PackageReference Include="Serilog.AspNetCore" /> 
    <PackageReference Include="Serilog.Enrichers.Thread" />
	<PackageReference Include="Serilog.Sinks.OpenTelemetry" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalObservabilityAbstractions)' != 'true'">
	<PackageReference Include="CoreSystem.Observability.Abstractions" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalObservabilityAbstractions)' == 'true'">
    <ProjectReference Include="..\Core.Observability.Abstractions\Core.Observability.Abstractions.csproj" />
  </ItemGroup>
</Project>

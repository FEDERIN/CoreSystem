<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<UseLocalObservabilityAbstractions Condition="'$(UseLocalObservabilityAbstractions)' == ''">false</UseLocalObservabilityAbstractions>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>CoreSystem.Observability</PackageId>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <InformationalVersion>1.0.2</InformationalVersion>
    <Authors>Federin Pastor Gutierrez Ortiz</Authors>
    <Description>Standardized observability for .NET 8 Cloud-Native apps with OpenTelemetry and Serilog.</Description>
    <PackageReleaseNotes>
      1.0.2: Package-only fix. The 1.0.1 nuspec declared CoreSystem.Observability.Abstractions 1.0.0 because the package was tagged before the central pin was refreshed. This release declares 1.0.1. No code or API changes.
    </PackageReleaseNotes>
    <RepositoryUrl>https://github.com/FEDERIN/CoreSystem</RepositoryUrl>
	<PackageProjectUrl>https://github.com/FEDERIN/CoreSystem/tree/main/src/Core.Observability</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
	<None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Data.SqlClient" />
	
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" />
	<PackageReference Include="Serilog.AspNetCore" /> 
    <PackageReference Include="Serilog.Enrichers.Thread" />
	<PackageReference Include="Serilog.Sinks.OpenTelemetry" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalObservabilityAbstractions)' != 'true'">
	<PackageReference Include="CoreSystem.Observability.Abstractions" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalObservabilityAbstractions)' == 'true'">
    <ProjectReference Include="..\Core.Observability.Abstractions\Core.Observability.Abstractions.csproj" />
  </ItemGroup>
</Project>

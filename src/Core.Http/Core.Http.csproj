<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>CoreSystem.Http</PackageId>
		<Version>1.2.0</Version>
		<Authors>Federin Pastor Gutierrez Ortiz</Authors>
		<Description>
			Production-ready HTTP infrastructure library for .NET 8, .NET 9 and .NET 10 providing reusable components for capturing and replaying HTTP responses in ASP.NET Core applications.
		</Description>
		<PackageTags>
			HTTP;
			ASP.NET Core;
			Middleware;
			Response;
			ResponseCapture;
			ResponseReplay;
			HttpContext;
			Infrastructure;
			DependencyInjection;
			.NET8
		</PackageTags>
		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://federin.github.io/CoreSystem/Http</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<AssemblyVersion>1.2.0.0</AssemblyVersion>
		<FileVersion>1.2.0.0</FileVersion>
		<InformationalVersion>1.2.0</InformationalVersion>
		<PackageReleaseNotes>
			Initial stable release.
			• HTTP response capture
			• HTTP response replay
			• Header preservation
			• ASP.NET Core integration
			• Dependency Injection support
			• Production-ready implementation
			1.2.0: Targets net8.0, net9.0 and net10.0 (previously net8.0 only). No public API or behavior change; the net9.0 and net10.0 assets are new, and the net8.0 assembly is unchanged. The nuspec no longer declares Microsoft.Extensions.DependencyInjection.Abstractions and Microsoft.Extensions.Options as package dependencies: both assemblies ship in the Microsoft.AspNetCore.App framework reference the package already carries, so consumers are unaffected.
		</PackageReleaseNotes>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<ItemGroup>
		<!-- No Microsoft.Extensions.Options / DependencyInjection.Abstractions PackageReference here:
		     both assemblies ship in Microsoft.AspNetCore.App (the FrameworkReference below), so the
		     SDK 10 PrunePackageReference feature raises NU1510 for the net10.0 asset and strips them
		     from the nuspec anyway. The frameworkReference travels with the package, so consumers that
		     reference CoreSystem.Http get the framework (and these assemblies) for free. -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Core.Http.UnitTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>
	
</Project>

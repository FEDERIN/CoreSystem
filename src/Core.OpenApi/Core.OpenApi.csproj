<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

		<PackageId>CoreSystem.OpenApi</PackageId>
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<InformationalVersion>1.0.0</InformationalVersion>
		<Authors>Federin Pastor Gutierrez Ortiz</Authors>
		<Description>Reusable OpenAPI and Swagger infrastructure for ASP.NET Core APIs.</Description>
		<PackageTags>OpenAPI;Swagger;Swashbuckle;ASP.NET Core;Documentation;Problem Details;.NET8</PackageTags>
		<PackageReleaseNotes>
			Initial release. Swagger generation wiring, response attributes, operation and document
			filters, and a configurable OpenAPI document patcher that turns inline error responses
			into shared component references.
		</PackageReleaseNotes>

		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://federin.github.io/CoreSystem/OpenApi</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Core.OpenApi.UnitTests" />
	</ItemGroup>

</Project>

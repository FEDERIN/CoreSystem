<Project>
	<PropertyGroup>
		<!-- Central default TFMs: imported after Directory.Build.props and before each csproj, so any
         project that does not declare its own TargetFramework inherits net8.0;net9.0;net10.0.
         A project that must stay single-TFM sets TargetFramework in its nearest Directory.Build.props. -->
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="CoreSystem.Http" Version="1.2.0" />
		<PackageVersion Include="CoreSystem.Memory" Version="1.1.0" />
		<PackageVersion Include="CoreSystem.Observability" Version="1.1.0" />
		<PackageVersion Include="CoreSystem.Observability.Abstractions" Version="1.1.1" />
		<PackageVersion Include="CoreSystem.Redis" Version="1.1.0" />
		<PackageVersion Include="CoreSystem.Resilience" Version="2.1.1" />
		<PackageVersion Include="CoreSystem.Serialization" Version="1.3.1" />
		<PackageVersion Include="MessagePack" Version="3.1.12" />
		<PackageVersion Include="Microsoft.Build.Tasks.Git" Version="10.0.402" />
		<PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.2" />
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
		<PackageVersion Include="Polly" Version="8.9.1" />
		<PackageVersion Include="protobuf-net" Version="3.4.40" />
		<PackageVersion Include="protobuf-net.Core" Version="3.4.40" />
		<PackageVersion Include="SSH.NET" Version="2026.0.0" />
		<PackageVersion Include="StackExchange.Redis" Version="2.13.17" />
		<PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
		<PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
		<PackageVersion Include="coverlet.collector" Version="10.1.1" />
		<PackageVersion Include="FluentAssertions" Version="8.11.0" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageVersion Include="Moq" Version="4.21.0" />
		<PackageVersion Include="System.Threading.RateLimiting" Version="10.0.10" />
		<PackageVersion Include="Testcontainers.Redis" Version="4.17.0" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
		<PackageVersion Include="xunit.v3" Version="4.0.3" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.32" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="8.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
		<PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.32" />
		<PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
		<PackageVersion Include="Serilog.AspNetCore" Version="8.0.3" />
		<PackageVersion Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
		<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
		<PackageVersion Include="OpenTelemetry" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Api" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.20.1" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="9.0.21" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="9.0.21" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="9.0.21" />
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="9.0.21" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.21" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.21" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.21" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.21" />
		<PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="9.0.21" />
		<PackageVersion Include="Microsoft.Extensions.Options" Version="9.0.21" />
		<PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
		<PackageVersion Include="System.Configuration.ConfigurationManager" Version="9.0.21" />
		<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
		<PackageVersion Include="OpenTelemetry" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Api" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.20.1" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
		<PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.15" />
		<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
		<PackageVersion Include="OpenTelemetry" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Api" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.21.0" />
	</ItemGroup>
</Project>
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {},

  "RedisConnections": {
    "MainRedis": {
      "Host": "localhost:6379",
      "Password": "foobared",
      "Database": 0,
      "Ssl": false
    }
  },
  "Core": {
    "Cache": {
      "DefaultProvider": "Memory",
      "InstanceName": "CoreSystem:App01",
      "Redis": {
        "Enabled": false
      }
    },
    "Resilience": {
      "Pipelines": {
        "Redis": {
          "Retry": {
            "MaxRetryAttempts": 2,
            "Delay": "00:00:01",
            "BackoffType": "Exponential",
            "IncludeInnerExceptions": true
          },
          "CircuitBreaker": {
            "FailureRatio": 0.5,
            "MinimumThroughput": 10,
            "IncludeInnerExceptions": true
          },
          "Timeout": {
            "Timeout": "00:00:30"
          }
        }
      }
    },
    "Idempotency": {
      "Enabled": true,
      "Provider": "Redis",
      "AllowedMethods": [
        "POST"
      ],
      "InstanceName": "CoreSystem:App01",
      "Expiration": "01:00:00",
      "Redis": {
        "Enabled": true
      },
      //"PostgreSql": {
      //  "ConnectionString": "Host=localhost;Port=5433;Database=idempotency_db;Username=admin;Password=admin_password_123"
      //},
      "Fingerprint": {
        "Enabled": true,
        "IncludeQueryString": true,
        "IncludeContentType": true,
        "IncludedHeaders": [
          "Accept",
          "X-Tenant-Id"
        ]
      }
    }
  },
  "OpenTelemetry": {
    "Tracing": {
      "Enabled": false,
      "OtlpEndpoint": "http://localhost:4317"
    },
    "Metrics": {
      "Enabled": false,
      "OtlpEndpoint": "http://localhost:4317",
      "Meters": [
        "Core.Idempotency"
      ]
    },
    "Logging": {
      "Enabled": false,
      "OtlpEndpoint": "http://localhost:4317"
    }
  }
}